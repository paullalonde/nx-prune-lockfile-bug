{
	"extends": "nx/presets/npm.json",
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"namedInputs": {
		"environment": [
			{
				"runtime": "git rev-parse --abbrev-ref HEAD"
			}
		]
	},
	"targetDefaults": {
		"build": {
			"dependsOn": ["^build"]
		},
		"lint": {},
		"publish": {
			"dependsOn": ["package", "^publish"],
			"executor": "nx:run-commands",
			"options": {
				"command": "./bin/publish.sh"
			}
		},
		"test": {
			"dependsOn": ["build"]
		},
		"zzz-project-order": {
			"dependsOn": ["^zzz-project-order"],
			"executor": "nx:run-commands",
			"options": {
				"command": "echo $NX_TASK_TARGET_PROJECT >>.artifacts/project-order.txt"
			}
		}
	},
	"analytics": true,
	"neverConnectToCloud": true
}
