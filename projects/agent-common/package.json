{
	"name": "@internal/agent-common",
	"version": "3.2.0",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"scripts": {
		"build": "npx tsc -p tsconfig.src.json"
	},
	"files": [
		"dist/assets/**/*.pem",
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/package.json"
	],
	"license": "ISC",
	"dependencies": {
		"@aws-sdk/client-secrets-manager": "^3.637.0",
		"@internal/common": "*",
		"firebase-admin": "^12.7.0",
		"lodash": "^4.17.21",
		"safe-stable-stringify": "^2.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@types/jasmine": "^5.1.10",
		"@types/mock-fs": "^4.13.4",
		"@types/node": "^22.15.21",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"eslint": "^9.37.0",
		"jasmine": "^5.12.0",
		"jasmine-spec-reporter": "^7.0.0",
		"mock-fs": "^5.2.0",
		"nyc": "^17.1.0",
		"typescript": "^5.8.3"
	},
	"peerDependencies": {
		"@redis/client": "^6.1.0",
		"commander": "^12.1.0",
		"mysql2": "~3.16.3",
		"winston": "^3.8.2"
	},
	"engines": {
		"node": "^22.16.0"
	},
	"nx": {
		"includedScripts": [
			"build",
			"lint",
			"test"
		],
		"namedInputs": {
			"source": [
				"environment",
				"{projectRoot}/assets/**/*",
				"{projectRoot}/bin/postbuild.sh",
				"{projectRoot}/src/**/*",
				"{projectRoot}/tsconfig.*"
			]
		},
		"targets": {
			"build": {
				"inputs": [
					"source",
					"^source"
				],
				"outputs": [
					"{projectRoot}/dist/"
				]
			},
			"lint": {
				"inputs": [
					"source",
					"{projectRoot}/spec/**/*",
					"{projectRoot}/eslint.config.ts"
				]
			},
			"test": {
				"inputs": [
					"source",
					"{projectRoot}/spec/**/*",
					"{projectRoot}/.nycrc.*",
					"^source"
				],
				"outputs": [
					"{projectRoot}/.nyc_output/",
					"{projectRoot}/coverage/",
					"{projectRoot}/dist-spec/"
				]
			}
		}
	}
}
