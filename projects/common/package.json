{
	"name": "@internal/common",
	"version": "3.2.0",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"scripts": {
		"build": "npm run build:esm && npm run build:cjs",
		"build:cjs": "npx tsc -p tsconfig.cjs.json",
		"build:esm": "npx tsc -p tsconfig.esm.json",
		"postbuild": "bash bin/fixup-packages.sh"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js"
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.js.map",
		"dist/**/*.d.ts",
		"dist/**/package.json"
	],
	"license": "ISC",
	"dependencies": {
		"lodash": "^4.17.21",
		"moment": "^2.29.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@types/deep-diff": "^1.0.1",
		"@types/jasmine": "^5.1.10",
		"@types/lodash": "^4.17.20",
		"@types/node": "^22.15.21",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"deep-diff": "^1.0.2",
		"eslint": "^9.37.0",
		"jasmine": "^5.12.0",
		"jasmine-spec-reporter": "^7.0.0",
		"nyc": "^17.1.0",
		"ts-loader": "^9.3.1",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": "^22.16.0"
	},
	"nx": {
		"includedScripts": [
			"build",
			"lint",
			"test"
		],
		"namedInputs": {
			"source": [
				"environment",
				"{projectRoot}/bin/fixup-packages.sh",
				"{projectRoot}/src/**/*",
				"{projectRoot}/tsconfig.*"
			]
		},
		"targets": {
			"build": {
				"inputs": [
					"source"
				],
				"outputs": [
					"{projectRoot}/dist/"
				]
			},
			"lint": {
				"inputs": [
					"source",
					"{projectRoot}/spec/**/*",
					"{projectRoot}/.eslintrc.js"
				]
			},
			"test": {
				"inputs": [
					"source",
					"{projectRoot}/spec/**/*",
					"{projectRoot}/.nycrc.*"
				],
				"outputs": [
					"{projectRoot}/.nyc_output/",
					"{projectRoot}/coverage/",
					"{projectRoot}/dist-spec/"
				]
			}
		}
	}
}
