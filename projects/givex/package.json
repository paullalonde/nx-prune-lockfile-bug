{
	"name": "@internal/givex",
	"version": "3.2.0",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"scripts": {
		"build": "npm run build:esm && npm run build:cjs",
		"build:cjs": "npx tsc -p tsconfig.cjs.json",
		"build:esm": "npx tsc -p tsconfig.esm.json",
		"postbuild": "bash bin/fixup-packages.sh"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.js",
			"import": "./dist/esm/index.js"
		}
	},
	"files": [
		"dist"
	],
	"license": "ISC",
	"dependencies": {
		"@internal/common": "*",
		"axios": "^1.13.0",
		"axios-retry": "^4.5.0",
		"jayson": "^3.6.3",
		"moment": "^2.29.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@types/jasmine": "^5.1.10",
		"@types/node": "^22.15.21",
		"eslint": "^9.37.0",
		"jasmine": "^5.12.0",
		"jasmine-spec-reporter": "^7.0.0",
		"nyc": "^17.1.0",
		"typescript": "^5.8.3"
	},
	"engines": {
		"node": "^22.16.0"
	},
	"nx": {
		"includedScripts": [
			"build",
			"lint",
			"test"
		],
		"namedInputs": {
			"source": [
				"environment",
				"{projectRoot}/src/**/*",
				"{projectRoot}/tsconfig.*"
			]
		},
		"targets": {
			"build": {
				"inputs": [
					"source",
					"^source"
				],
				"outputs": [
					"{projectRoot}/dist/"
				]
			},
			"lint": {
				"inputs": [
					"source",
					"{projectRoot}/spec/**/*",
					"{projectRoot}/eslint.config.ts"
				]
			},
			"test": {
				"inputs": [
					"source",
					"{projectRoot}/spec/**/*",
					"{projectRoot}/.nycrc.*",
					"^source"
				],
				"outputs": [
					"{projectRoot}/.nyc_output/",
					"{projectRoot}/coverage/",
					"{projectRoot}/dist-spec/"
				]
			}
		}
	}
}
